{
  "name": "@md/api",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for doocs/md – Cloudflare Worker (Hono + D1): GitHub OAuth account, cloud sync, and billing",
  "scripts": {
    "dev": "wrangler dev",
    "dev:private": "wrangler dev --config wrangler.private.jsonc",
    "check:private": "wrangler deploy --dry-run --config wrangler.private.jsonc --outdir ../../.private-worker-check",
    "deploy": "wrangler deploy --minify",
    "db:migrate:local": "wrangler d1 migrations apply md-sync --local",
    "db:migrate:remote": "wrangler d1 migrations apply md-sync --remote",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@md/shared": "workspace:*",
    "hono": "^4.13.13",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
